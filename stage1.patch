diff --git a/.github/workflows/vogue-apk.yml b/.github/workflows/vogue-apk.yml
new file mode 100644
index 0000000..0f1574c
--- /dev/null
+++ b/.github/workflows/vogue-apk.yml
@@ -0,0 +1,28 @@
+name: Vogue APK
+
+on:
+  push:
+    branches: [main]
+  workflow_dispatch:
+
+permissions:
+  contents: read
+
+jobs:
+  apk:
+    runs-on: ubuntu-latest
+    timeout-minutes: 30
+    steps:
+      - uses: actions/checkout@v7
+      # JDK 25: Kadb ships Java 25 bytecode.
+      - uses: actions/setup-java@v6
+        with:
+          distribution: temurin
+          java-version: 25
+      - uses: gradle/actions/setup-gradle@v6
+      - run: ./gradlew :app:assembleDebug --console=plain
+      - uses: actions/upload-artifact@v7
+        with:
+          name: vogue-tools-apk
+          path: app/build/outputs/apk/debug/*.apk
+          retention-days: 30
diff --git a/adb/src/main/kotlin/app/tellyscope/adb/Protected.kt b/adb/src/main/kotlin/app/tellyscope/adb/Protected.kt
index 096031e..98c3d2e 100644
--- a/adb/src/main/kotlin/app/tellyscope/adb/Protected.kt
+++ b/adb/src/main/kotlin/app/tellyscope/adb/Protected.kt
@@ -77,6 +77,11 @@ object Protected {
         "bluetooth" to ProtectedReason.TV_INPUTS_REMOTE,
         "remote" to ProtectedReason.TV_INPUTS_REMOTE,
         "rcu" to ProtectedReason.TV_INPUTS_REMOTE,
+        // Vogue One (Samsat, Amlogic S905H): its home screen, DTV player and TV service live under
+        // these names; stopping them kills channel playback, so they stay on.
+        "streambus" to ProtectedReason.SYSTEM,
+        "tvservice" to ProtectedReason.SYSTEM,
+        "dtvplayer" to ProtectedReason.SYSTEM,
         "setupwizard" to ProtectedReason.SETUP_WIZARD,
         "setupwraith" to ProtectedReason.SETUP_WIZARD,
         "bootwizard" to ProtectedReason.SETUP_WIZARD,
